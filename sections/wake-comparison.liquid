{% liquid
  assign section_id = 'wake-comparison-' | append: section.id
%}

<style>
  #{{ section_id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --border: {{ section.settings.border_color }};
    --highlight-bg: {{ section.settings.highlight_bg }};
    --highlight-text: {{ section.settings.highlight_text }};
    --check-color: {{ section.settings.check_color }};
    --cross-color: {{ section.settings.cross_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --icon-border: {{ section.settings.icon_border }};
    --table-radius: {{ section.settings.table_radius }}px;
    background: var(--bg);
    color: var(--text);
  }

  #{{ section_id }} .wake-comparison__inner {
    max-width: {% if section.settings.full_width %}100%{% else %}1400px{% endif %};
    margin: 0 auto;
    padding: {{ section.settings.padding_top | minus: 45 }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom | minus: 45 }}px;
  }

  #{{ section_id }} .wake-comparison__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(540px, 0.95fr);
    gap: 56px;
    align-items: center;
  }

  #{{ section_id }} .wake-comparison__content {
    max-width: 760px;
  }

  #{{ section_id }} .wake-comparison__heading {
    margin: 0 0 14px;
    font-size: clamp(40px, 4vw, {{ section.settings.heading_size }}px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  #{{ section_id }} .wake-comparison__heading em {
    font-style: italic;
    font-weight: 400;
    color: {{ section.settings.heading_color_1 }};
  }

  #{{ section_id }} .wake-comparison__heading strong {
    font-style: normal;
    font-weight: 800;
    color: {{ section.settings.heading_color_2 }};
  }

  #{{ section_id }} .wake-comparison__subtext {
    margin: 0 0 40px;
    color: {{ section.settings.text_color_custom }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.45;
    max-width: 680px;
  }

  #{{ section_id }} .wake-comparison__subtext strong {
    font-weight: 800;
  }

  #{{ section_id }} .wake-comparison__features {
    display: grid;
    gap: 24px;
    margin: 0 0 40px;
  }

  #{{ section_id }} .wake-comparison__feature {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #{{ section_id }} .wake-comparison__feature-icon {
    width: 30px;
    height: 30px;
    min-width: 30px;
    border: 1.5px solid var(--icon-border);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  #{{ section_id }} .wake-comparison__feature-icon::before {
    content: "";
    width: 8px;
    height: 13px;
    border-right: 1.8px solid var(--text);
    border-bottom: 1.8px solid var(--text);
    transform: rotate(45deg) translate(-1px, -1px);
    display: block;
  }

  #{{ section_id }} .wake-comparison__feature-text {
    font-size: {{ section.settings.feature_text_size }}px;
    line-height: 1.3;
    color: var(--text);
  }

  #{{ section_id }} .wake-comparison__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 305px;
    min-height: 68px;
    padding: 16px 28px;
    border-radius: 999px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    font-weight: 800;
    font-size: {{ section.settings.button_text_size }}px;
    line-height: 1.05;
    text-align: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #{{ section_id }} .wake-comparison__button:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  #{{ section_id }} .wake-comparison__button--mobile {
    display: none;
  }

  #{{ section_id }} .wake-comparison__table-wrap {
    width: 100%;
  }

  #{{ section_id }} .wake-comparison__table {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--table-radius);
    overflow: hidden;
    background: transparent;
  }

  #{{ section_id }} .wake-comparison__table-scroll {
    width: 100%;
  }

  #{{ section_id }} .wake-comparison__head,
  #{{ section_id }} .wake-comparison__row {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 0.95fr;
  }

  #{{ section_id }} .wake-comparison__head > div,
  #{{ section_id }} .wake-comparison__row > div {
    min-height: 74px;
    display: flex;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
  }

  #{{ section_id }} .wake-comparison__row:last-child > div {
    border-bottom: 0;
  }

  #{{ section_id }} .wake-comparison__head > div:not(:last-child),
  #{{ section_id }} .wake-comparison__row > div:not(:last-child) {
    border-right: 1px solid var(--border);
  }

  #{{ section_id }} .wake-comparison__head > div:first-child {
    background: transparent;
  }

  #{{ section_id }} .wake-comparison__head-label {
    justify-content: center;
    text-align: center;
    font-size: {{ section.settings.table_head_size }}px;
    font-weight: 800;
    line-height: 1.1;
  }

  #{{ section_id }} .wake-comparison__head-label--highlight,
  #{{ section_id }} .wake-comparison__cell--highlight {
    background: var(--highlight-bg);
    color: var(--highlight-text);
  }

  #{{ section_id }} .wake-comparison__label {
    font-size: {{ section.settings.table_label_size }}px;
    line-height: 1.05;
    font-weight: 700;
    color: var(--text);
  }

  #{{ section_id }} .wake-comparison__cell {
    justify-content: center;
    text-align: center;
  }

  #{{ section_id }} .wake-comparison__symbol {
    font-size: 38px;
    line-height: 1;
    font-weight: 500;
  }

  #{{ section_id }} .wake-comparison__symbol--check {
    color: var(--check-color);
  }

  #{{ section_id }} .wake-comparison__symbol--cross {
    color: var(--cross-color);
  }

  @media screen and (max-width: 768px) {
    #{{ section_id }} .wake-comparison__inner {
      padding: {{ section.settings.padding_top_mobile | minus: 20 }}px 14px {{ section.settings.padding_bottom_mobile | minus: 20 }}px;
    }
  }
</style>