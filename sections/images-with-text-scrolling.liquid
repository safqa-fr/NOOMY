{%- render 'section-spacing-collapsing' -%}

<style>
#shopify-section-{{ section.id }} {
  --images-scrolling-block-count: {{ section.blocks.size }};
}

#shopify-section-{{ section.id }} .images-scrolling__media,
#shopify-section-{{ section.id }} .images-scrolling__media img,
#shopify-section-{{ section.id }} .images-scrolling__media video{
  width:100%;
  display:block;
  border-radius:var(--rounded-sm);
  overflow:hidden;
}

#shopify-section-{{ section.id }} .images-scrolling__media video{
  object-fit:cover;
}

#shopify-section-{{ section.id }} .custom-heading{
  font-size:{{ section.settings.heading_size }}px;
  line-height:1.2;
}

@media screen and (max-width:740px){

  #shopify-section-{{ section.id }} .images-scrolling-mobile__item--media-last{
    display:flex;
    flex-direction:column;
  }

  #shopify-section-{{ section.id }} .images-scrolling-mobile__item--media-last .images-scrolling__content{
    order:1;
  }

  #shopify-section-{{ section.id }} .images-scrolling-mobile__item--media-last .images-scrolling__media{
    order:2;
    margin-top:16px;
  }

}

</style>

<div {% render 'section-properties', narrow: true %}>

<images-with-text-scrolling class="images-scrolling-mobile scroll-area bleed sm:unbleed">

{% for block in section.blocks %}

<div class="images-scrolling-mobile__item snap-start {% if section.settings.mobile_media_position == 'media_last' %}images-scrolling-mobile__item--media-last{% endif %}" {{ block.shopify_attributes }}>

<div class="images-scrolling__media">

{% if block.settings.media_type == 'video' and block.settings.video != blank %}

{{
block.settings.video
| video_tag:
autoplay:block.settings.enable_autoplay,
loop:block.settings.enable_loop,
muted:true,
controls:block.settings.show_controls,
playsinline:true
}}

{% elsif block.settings.image != blank %}

{{ block.settings.image | image_url: width: block.settings.image.width | image_tag:
loading:'lazy',
sizes:'(max-width:740px) 100vw,650px',
widths:'200,300,400,600,800,1000,1200,1400,1600'
}}

{% endif %}

</div>


<div class="images-scrolling__content">

{% if section.settings.show_counter %}
<span class="images-scrolling__counter bold">{{ forloop.index | prepend:'00' | slice:-2,2 }}</span>
{% endif %}

<div class="prose">

{% if block.settings.title != blank %}

<p class="custom-heading"
{% if settings.heading_apparition != 'none' %}
reveal-on-scroll="true"
{% endif %}
>

{{ block.settings.title }}

</p>

{% endif %}

{{ block.settings.content }}

</div>

</div>

</div>

{% endfor %}

</images-with-text-scrolling>



<images-with-text-scrolling scrolling-experience="{{ section.settings.desktop_image_effect }}" class="images-scrolling-desktop">

<div class="images-scrolling-desktop__content-list">

{% for block in section.blocks %}

<div class="images-scrolling__content {% unless forloop.first %}opacity-0{% endunless %}">

{% if section.settings.show_counter %}
<span class="images-scrolling__counter bold">{{ forloop.index | prepend:'00' | slice:-2,2 }}</span>
{% endif %}

<div class="prose">

{% if block.settings.title != blank %}

<p class="custom-heading"
{% if settings.heading_apparition != 'none' %}
reveal-on-scroll="true"
{% endif %}
>

{{ block.settings.title }}

</p>

{% endif %}

{{ block.settings.content }}

</div>

</div>

{% endfor %}

</div>


<div class="images-scrolling-desktop__media-wrapper">

{% for block in section.blocks %}

<div class="images-scrolling__media">

{% if block.settings.media_type == 'video' and block.settings.video != blank %}

{{
block.settings.video
| video_tag:
autoplay:block.settings.enable_autoplay,
loop:block.settings.enable_loop,
muted:true,
controls:block.settings.show_controls,
playsinline:true
}}

{% elsif block.settings.image != blank %}

{{ block.settings.image | image_url: width: block.settings.image.width | image_tag:
loading:'lazy',
sizes:'(max-width:740px) 100vw,650px',
widths:'200,300,400,600,800,1000,1200,1400,1600'
}}

{% endif %}

</div>

{% endfor %}

</div>

</images-with-text-scrolling>

</div>


{% schema %}
{
"name": "Images and text scrolling",
"tag": "section",
"class": "shopify-section--images-and-text-scrolling",
"max_blocks": 15,

"settings": [

{
"type": "range",
"id": "heading_size",
"label": "Heading size",
"min": 20,
"max": 80,
"step": 2,
"default": 36
},

{
"type": "select",
"id": "mobile_media_position",
"label": "Mobile media position",
"options": [
{
"value": "media_first",
"label": "Media first"
},
{
"value": "media_last",
"label": "Media last"
}
],
"default": "media_first"
},

{
"type": "checkbox",
"id": "show_counter",
"label": "Show counter",
"default": true
},

{
"type": "select",
"id": "desktop_image_effect",
"label": "Desktop image transition",
"options": [
{
"value": "reveal",
"label": "Reveal"
},
{
"value": "fade",
"label": "Fade"
}
],
"default": "reveal"
}

],

"blocks": [

{
"type": "item",
"name": "Item",
"settings": [

{
"type": "select",
"id": "media_type",
"label": "Media type",
"options": [
{
"value": "image",
"label": "Image"
},
{
"value": "video",
"label": "Video"
}
],
"default": "image"
},

{
"type": "image_picker",
"id": "image",
"label": "Image"
},

{
"type": "video",
"id": "video",
"label": "Video"
},

{
"type": "checkbox",
"id": "enable_autoplay",
"label": "Autoplay video",
"default": true
},

{
"type": "checkbox",
"id": "enable_loop",
"label": "Loop video",
"default": true
},

{
"type": "checkbox",
"id": "show_controls",
"label": "Show controls",
"default": false
},

{
"type": "text",
"id": "title",
"label": "Heading",
"default": "Heading"
},

{
"type": "richtext",
"id": "content",
"label": "Content",
"default": "<p>Describe your product or feature.</p>"
}

]
}

],

"presets": [
{
"name": "Images and text scrolling"
}
]

}
{% endschema %}